# Copiar este archivo como .env (en la carpeta backend/) y completar con tus datos de MySQL.
# El archivo .env NO se sube a GitHub.
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=gestion_farmacia

# Clave con la que Flask firma la cookie de sesión del login. Poné un texto largo y propio.
SECRET_KEY=cambiar-por-un-texto-largo-y-secreto
